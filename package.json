{
  "name": "earth-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "pg": "^8.16.3"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js",
    "test": "node --test test/server.smoke.test.js test/simulation.test.js && node --experimental-strip-types --test test/opportunities.test.mjs test/game-clock.test.mjs test/financial-postgres.test.mjs test/repository.test.mjs test/request-validation.test.mjs test/money.test.mjs test/starter-package.test.mjs test/business-finance.test.mjs test/scheduler-postgres.test.mjs && node --test test/outbox.test.mjs",
    "cf:smoke": "node test/cloudflare.smoke.mjs",
    "cf:check": "wrangler deploy --dry-run",
    "cf:assert-postgres": "node scripts/assert-postgres-authority.mjs",
    "audit:mutation-boundaries": "node scripts/audit-mutation-boundaries.mjs",
    "flutter:prepare:web": "node scripts/prepare-flutter-assets.mjs",
    "cf:types": "wrangler types",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "db:seed:postgres": "node scripts/seed-postgres.mjs",
    "db:verify:manifest": "node scripts/verify-schema-manifest.mjs",
    "db:verify:invariants": "node scripts/verify-postgres-invariants.mjs",
    "test:postgres": "node --test test/postgres-integration.test.mjs",
    "simulate:scenarios": "node scripts/run-simulation-scenarios.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "wrangler": "^4.123.0"
  }
}
